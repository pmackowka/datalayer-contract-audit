# Szablon konfiguracji. Skopiuj do .env i uzupełnij: cp .env.example .env
#
# Wzorzec (glob Playwrighta) ścieżki first-party loadera GTM, który testy blokują,
# żeby nic nie trafiło do GA4. Znajdziesz go w źródle strony: adres skryptu,
# który doczepia snippet GTM. Bez tej wartości scenariusze E2E nie ruszą.
GTM_LOADER_GLOB=**/sciezka-loadera/**
